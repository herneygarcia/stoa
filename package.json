{
  "name": "stoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "daily": "node --experimental-strip-types scripts/daily-case/run.ts",
    "evals": "node --experimental-strip-types scripts/daily-case/evals.ts",
    "verify": "npm run check && npm run lint && npm run duplicacion && npm run muerto && npm run validate:content && npm run test:cobertura && npm run evals && npm run mutacion",
    "evals:llm": "node --experimental-strip-types scripts/daily-case/evals.ts --llm",
    "iconos": "node scripts/iconos.mjs",
    "lint": "eslint .",
    "duplicacion": "jscpd src scripts tests",
    "muerto": "knip",
    "test:cobertura": "vitest run --coverage",
    "mutacion": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@astrojs/preact": "^6.0.5",
    "astro": "^7.3.3",
    "gray-matter": "^4.0.3",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
