{
  "name": "stoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "daily": "node --experimental-strip-types scripts/daily-case/run.ts",
    "evals": "node --experimental-strip-types scripts/daily-case/evals.ts",
    "verify": "npm run check && npm run validate:content && npm test && npm run evals",
    "evals:llm": "node --experimental-strip-types scripts/daily-case/evals.ts --llm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@astrojs/preact": "^6.0.5",
    "astro": "^7.3.3",
    "gray-matter": "^4.0.3",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
