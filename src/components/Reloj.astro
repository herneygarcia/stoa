---
// Firma visual: el pórtico como reloj de sol. La sombra de la columna cae sobre las
// líneas horarias según la hora real en Colombia. De noche no hay sombra: es la hora del examen.
import { romano } from '../lib/url';
import { SUELO, HORAS, puntoHorario, sombra, puntosSVG } from '../lib/reloj';

const { cx: CX, cy: CY, rx: RX, ry: RY } = SUELO;
---
<figure class="reloj" data-reloj aria-label="Reloj de sol: la sombra de la columna indica la hora en Colombia">
  <svg viewBox="-24 0 448 280" role="img" aria-hidden="true">
    <defs>
      <linearGradient id="fuste" x1="0" x2="1">
        <stop offset="0" stop-color="var(--marmol)" />
        <stop offset=".55" stop-color="var(--marmol)" />
        <stop offset="1" stop-color="var(--cal-2)" />
      </linearGradient>
    </defs>

    <!-- astro: sol (día) / luna (noche) -->
    <circle data-sol r="11" cx="60" cy="70" fill="var(--ocre)" />
    <path data-luna d="M338 42a16 16 0 1 0 12 26a13 13 0 1 1 -12 -26z" fill="var(--ocre)" opacity="0" />

    <!-- suelo: plano del reloj con sus líneas horarias -->
    <ellipse cx={CX} cy={CY} rx={RX} ry={RY} fill="var(--cal-2)" stroke="var(--veta)" />
    {HORAS.map((h) => {
      const p = puntoHorario(h);
      const l = puntoHorario(h, 1.13);
      return (
        <g>
          <line x1={CX} y1={CY} x2={p.x} y2={p.y} stroke="var(--veta)" stroke-width={h === 12 ? 1.4 : 0.8} />
          <text x={l.x} y={l.y + 4} text-anchor="middle" class="hora" data-h={h}>{romano(h > 12 ? h - 12 : h)}</text>
        </g>
      );
    })}

    <!-- sombra -->
    <polygon data-sombra points={puntosSVG(sombra(9))} fill="var(--piedra)" opacity=".22" />

    <!-- columna dórica -->
    <g stroke="var(--piedra)" stroke-width="1.4" stroke-linejoin="round">
      <rect x={CX - 26} y="52" width="52" height="9" fill="var(--marmol)" />
      <path d={`M${CX - 21} 61 h42 l-5 10 h-32 z`} fill="var(--marmol)" />
      <path d={`M${CX - 16} 71 L${CX - 14} ${CY - 6} H${CX + 14} L${CX + 16} 71 Z`} fill="url(#fuste)" />
      <path d={`M${CX - 7} 74 L${CX - 6} ${CY - 8} M${CX} 74 V${CY - 8} M${CX + 7} 74 L${CX + 6} ${CY - 8}`} stroke-width=".7" opacity=".5" />
      <rect x={CX - 20} y={CY - 7} width="40" height="7" fill="var(--marmol)" />
    </g>
  </svg>
  <figcaption class="inscripcion"><span data-hora-texto>Colombia</span></figcaption>
</figure>

<style>
  .reloj { margin: 0; }
  .reloj svg { width: 100%; height: auto; overflow: visible; }
  .hora { font: 11px var(--f-inscripcion); fill: var(--piedra-2); letter-spacing: .06em; }
  .hora.actual { fill: var(--ocre-texto); font-weight: 700; }
  [data-sombra], [data-sol], [data-luna] { transition: all 1.2s var(--curva); }
  figcaption { text-align: center; margin-top: .25rem; }
</style>

<script>
  import { esDeDia, sombra, sol, puntosSVG } from '../lib/reloj';
  import { horaEnColombia, momentoDelDia, formatoHora } from '../lib/tiempo';

  function pintar(reloj: HTMLElement) {
    const h = horaEnColombia();
    const dia = esDeDia(h);
    const figura = {
      sombra: reloj.querySelector<SVGPolygonElement>('[data-sombra]'),
      sol: reloj.querySelector<SVGCircleElement>('[data-sol]'),
      luna: reloj.querySelector<SVGPathElement>('[data-luna]'),
      texto: reloj.querySelector('[data-hora-texto]'),
    };
    if (!figura.sombra || !figura.sol || !figura.luna || !figura.texto) return;

    figura.sombra.setAttribute('points', puntosSVG(sombra(h)));
    figura.sombra.style.opacity = dia ? '0.28' : '0';
    const s = sol(h);
    figura.sol.setAttribute('cx', String(s.x));
    figura.sol.setAttribute('cy', String(s.y));
    figura.sol.style.opacity = dia ? '1' : '0';
    figura.luna.style.opacity = dia ? '0' : '1';
    reloj.querySelectorAll('.hora').forEach((t) => t.classList.toggle('actual', dia && Number(t.getAttribute('data-h')) === Math.round(h)));
    figura.texto.textContent = `Colombia · ${formatoHora(h)}`;
    document.documentElement.dataset.momento = momentoDelDia(h);
  }

  document.querySelectorAll<HTMLElement>('[data-reloj]').forEach((r) => {
    pintar(r);
    setInterval(() => pintar(r), 60_000);
  });
</script>
