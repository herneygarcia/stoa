---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cita from '../../components/Cita.astro';
import { url, romano } from '../../lib/url';

export async function getStaticPaths() {
  const ps = (await getCollection('principios')).sort((a, b) => a.data.orden - b.data.orden);
  return ps.map((p, i) => ({ params: { slug: p.id }, props: { p, sig: ps[i + 1] ?? null } }));
}
const { p, sig } = Astro.props;
const { Content } = await render(p);
const practicas = (await getCollection('practicas')).filter((x) => p.data.practicas.includes(x.id));
const casos = (await getCollection('casos')).filter((c) => c.data.principio === p.id && !c.data.fecha).slice(0, 4);
---
<Base titulo={p.data.titulo} seccion="principios" descripcion={p.data.resumen}>
  <article class="envoltura">
    <header class="cabeza">
      <p class="inscripcion"><a href={url('/principios')}>Principios</a> · {romano(p.data.orden)}</p>
      <h1>{p.data.titulo}</h1>
      <p class="termino">{p.data.termino}</p>
      <p class="resumen">{p.data.resumen}</p>
    </header>
    <div class="dos">
      <div class="texto"><Content /></div>
      <aside class="lateral">
        <div class="ejemplo">
          <p class="inscripcion">En la vida real</p>
          <p>{p.data.ejemplo}</p>
        </div>
        {p.data.citas.map((c) => <Cita id={c} />)}
        {practicas.length > 0 && (
          <div>
            <p class="inscripcion">Para practicarlo</p>
            <ul class="enl">{practicas.map((x) => <li><a href={url(`/practicas/${x.id}`)}>{x.data.titulo}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>
    {casos.length > 0 && (
      <section class="casos">
        <p class="inscripcion">Casos donde aparece</p>
        <ul class="enl">{casos.map((c) => <li><a href={url(`/casos/${c.id.split('/').pop()}`)}>{c.data.titulo}</a></li>)}</ul>
      </section>
    )}
    {sig && <p class="sig"><span class="inscripcion">Siguiente</span> <a href={url(`/principios/${sig.id}`)}>{romano(sig.data.orden)}. {sig.data.titulo}</a></p>}
  </article>
</Base>
<style>
  .cabeza { padding-block: var(--e-4) var(--e-3); max-width: 46rem; }
  .termino { font: italic var(--t-2) var(--f-display); color: var(--piedra-2); }
  .resumen { font-size: var(--t-2); border-left: 3px solid var(--ocre); padding-left: var(--e-2); }
  .dos { display: grid; gap: var(--e-4); }
  @media (min-width: 60rem) { .dos { grid-template-columns: minmax(0, 38rem) minmax(0, 1fr); gap: var(--e-5); } }
  .ejemplo { background: var(--marmol); padding: var(--e-3); border-radius: var(--radio); }
  .enl { padding-left: 1.1em; }
  .casos, .sig { margin-top: var(--e-4); padding-top: var(--e-3); border-top: 1px solid var(--veta); }
  .sig a { font: 400 var(--t-3) var(--f-display); }
</style>
