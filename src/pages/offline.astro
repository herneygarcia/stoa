---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base titulo="Sin conexión">
  <section class="envoltura texto cuerpo">
    <p class="inscripcion">Sin conexión</p>
    <h1>Esta página no está guardada todavía</h1>
    <p>La conexión no depende de ti; lo que haces mientras vuelve, sí. Las páginas que ya visitaste y tu diario siguen disponibles.</p>
    <p><a class="boton" href={url('/diario')}>Abrir mi diario</a></p>
  </section>
</Base>
<style>.cuerpo { padding-top: var(--e-5); } .cuerpo h1 { font-size: var(--t-4); }</style>
